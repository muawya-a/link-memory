# Optional local overrides. Keep the services on loopback for this preview.
MEMORY_GATEWAY_HOST=127.0.0.1
MEMORY_GATEWAY_PORT=18000
MEMORY_GATEWAY_DATA=./data
MEMORY_GATEWAY_URL=http://127.0.0.1:18000
MEMORY_GATEWAY_DISCARD_RAW_AFTER_SUCCESS=false
MEMORY_DASHBOARD_HOST=127.0.0.1
MEMORY_DASHBOARD_PORT=18765
MEMORY_GATEWAY_CORS_ORIGINS=http://127.0.0.1:18765,http://localhost:18765

# Optional generic model API. Replace placeholders only in private .env.
MODEL_PROVIDER=YOUR_API_PROVIDER
MODEL_NAME=YOUR_API_MODEL
MODEL_BASE_URL=YOUR_API_BASE_URL
MODEL_API_KEY=
MODEL_ENABLED=false

# Optional integrations stay disabled until deliberately enabled. Copy the
# variables you need into a private .env and follow OPTIONAL_INTEGRATIONS.md.
MEMORY_GATEWAY_REMOTE_EGRESS_ENABLED=false
MEMORY_GATEWAY_EGRESS_ALLOWLIST=
OLLAMA_ENABLED=false
OLLAMA_WARMUP_ENABLED=false
OLLAMA_URL=
OLLAMA_MODEL=
OLLAMA_EMBED_MODEL=
RERANKER_ENABLED=false
RERANKER_URL=
RERANKER_MODEL=
EMBEDDING_ENABLED=false
PROVIDER_RECALL_ENABLED=false
OPENMEMORY_ENABLED=false
OPENMEMORY_URL=
GRAPHITI_ENABLED=false
GRAPHITI_URL=
GRAPHITI_NEO4J_URI=bolt://127.0.0.1:17687
MEMORY_GATEWAY_NEO4J_ALLOWLIST=
GRAPHITI_NEO4J_PASSWORD=
GRAPHITI_OPENROUTER_API_KEY=
MEMPALACE_ENABLED=false
MEMPALACE_URL=
OPENROUTER_URL=
OPENROUTER_API_KEY=
